<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reviewed_Needs_Review_Date</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &apos;Reviewed&apos;) &amp;&amp; ISBLANK(Reviewed_On__c)</errorConditionFormula>
    <errorDisplayField>Reviewed_On__c</errorDisplayField>
    <errorMessage>Enter the Reviewed On date when marking a title Reviewed.</errorMessage>
</ValidationRule>
