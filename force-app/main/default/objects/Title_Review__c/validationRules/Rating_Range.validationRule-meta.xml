<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rating_Range</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK(Rating__c) || Rating__c &lt; 1 || Rating__c &gt; 5</errorConditionFormula>
    <errorDisplayField>Rating__c</errorDisplayField>
    <errorMessage>Pick 1 to 5 stars.</errorMessage>
</ValidationRule>
